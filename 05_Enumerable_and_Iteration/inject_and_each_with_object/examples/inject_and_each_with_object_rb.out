inject (also called reduce)
 1. nums.inject(:+)                                            10
 2. nums.inject(0) { |acc, x| acc + x }                        10
 3. nums.inject(10, :+)  (initial value, then a name)          20
 4. nums.inject(:*)                                            24
 5. reduce(:+); instance_method(:reduce) == (:inject)          [10, true]
 6. [].inject(:+), [].inject(0, :+), [].sum                    [nil, 0, 0]
 7. [7].inject { |a, b| raise }  (one element: no call)        7
 8. words.inject { |best, w| longer of the two }               "banana"
 9. (1..5).inject(:lcm), [12, 18, 24].inject(:gcd)             [60, 6]

sum is not inject(:+): floats are compensated
10. ([0.1] * 10).inject(:+)                                    0.9999999999999999
11. ([0.1] * 10).sum                                           1.0
12. [1e100, 1.0, -1e100].inject(:+), .sum                      [0.0, 1.0]
13. [0.1, 0.2, 0.3].inject(:+), .sum                           [0.6000000000000001, 0.6]
14. [1, Rational(1, 3)].sum, [1, 2].sum(0.0)                   [(4/3), 3.0]

each_with_object: the memo comes back whatever the block returns
15. words.each_with_object({}) { |w, h| h[w] = w.size }        {"apple" => 5, "banana" => 6, "cherry" => 6}
16. words.inject({}) { |h, w| h[w] = w.size; h }  (the ; h)    {"apple" => 5, "banana" => 6, "cherry" => 6}
17. nums.inject({}) { |h, x| h[x] = x * 10 } raises            "NoMethodError: undefined method '[]=' for an instance of Integer"
18. inject([]) { |acc, x| acc << x * 10 }  (<< returns acc)    [10, 20, 30, 40]
19. block args: each_with_object |x, memo|, inject |memo, x|   [[5, "memo"], ["memo", 5]]
20. each_with_object([]) { |w, acc| acc << w; :ignored }       ["apple", "banana", "cherry"]
21. each_with_object("") { |w, acc| acc += w }  (+= rebinds)   ["", "applebananacherry"]
22. each_with_object(Hash.new(0)) { |c, h| h[c] += 1 }         {"b" => 1, "a" => 3, "n" => 2}

Three more folds
23. words.sum(""), words.inject(:+)                            ["applebananacherry", "applebananacherry"]
24. [[1, 2], [3, 4]].inject(:+), .sum([])                      [[1, 2, 3, 4], [1, 2, 3, 4]]
25. each_with_index.inject(0) { |acc, (x, i)| acc + x * i }    20
