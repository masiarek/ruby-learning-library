1. three things at the top
   [c.__name__ for c in Plain.__mro__]            ['Plain', 'object']
   [c.__name__ for c in int.__mro__]              ['int', 'object']
   object.__bases__                               ()
   type(object).__name__                          type
   type(builtins).__name__                        module
   len(vars(object)) > 20  (object has its own methods) True
2. object: the root, and not small
   len(dir(object))                               24
   sorted(dir(object))                            __class__ __delattr__ __dir__ __doc__ __eq__ __format__
                                                  __ge__ __getattribute__ __getstate__ __gt__ __hash__ __init__
                                                  __init_subclass__ __le__ __lt__ __ne__ __new__ __reduce__
                                                  __reduce_ex__ __repr__ __setattr__ __sizeof__ __str__ __subclasshook__
3. builtins: a module every scope sees, not methods every object has
   functions:                                     print repr input open format int isinstance len exit
     all in vars(builtins)                        True
   methods:                                       __repr__ __str__ __eq__ __hash__ __class__ __getattribute__ __reduce__ __dir__
     all in dir(object)                           True
   print is builtins.print                        True
   print.__module__                               builtins
   hasattr(5, 'print')                            False
   hasattr(object(), 'print')                     False
4. there is no class below object
   Bare.__bases__[0] is object                    True
   hasattr(Bare(), '__repr__')                    True
   repr(Bare()).startswith('<__main__.Bare object at 0x') True
   del object.__repr__                            TypeError
   Rootless.__bases__ = ()                        TypeError
   bare == Bare()                                 False
   bare is bare                                   True
   not bare                                       False
   isinstance(bare, object)                       True
5. a proxy: __getattr__ forwards the misses, but not the dunders
   (forwarding copy)
   pr.copy()                                      [3, 1, 2]
   (forwarding __len__)
   pr.__len__()  (explicit call: forwarded)       3
   len(pr)  (implicit lookup skips __getattr__)   TypeError
   pr.__class__.__name__                          Proxy
   repr(pr).startswith('<__main__.Proxy object')  True
   isinstance(pr, list)                           False
   non-dunder names in vars(Proxy)                []
   (intercepting append)
   object.__getattribute__(st, '_target')         [1, 2]
