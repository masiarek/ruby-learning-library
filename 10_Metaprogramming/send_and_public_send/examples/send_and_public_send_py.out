 1. getattr(calc, "add")(2, 3)                     5
 2. operator.methodcaller("add", 2, 3)(calc)       5
 3. getattr(Report(), f"to_{fmt}")(), fmt = "csv"  'a,b'
 4. (1).__add__(2) / operator.add(1, 2)            3 / 3
 5. list(map(lambda x: x * 2, [1, 2, 3]))          [2, 4, 6]
 6. getattr(vault, "_code") / callable(...)        42 / False
 7. getattr(vault, "_secret")() -- convention only 'the code is 42'
 8. getattr(vault, "__mangled")                    AttributeError: no attribute '__mangled'
    getattr(vault, "_Vault__mangled")              7
 9. hasattr: "_secret" / "__mangled" / "_Vault__mangled" True / False / True
10. getattr(vault, "nope") -> type, e.name         AttributeError, 'nope'
    getattr(vault, "nope", None) -- a default      None
11. getattr(mailer, "deliver")() -- a builtin, not a method 'delivered'
    mailer.getattr("deliver") -- the class's own method 'shadow'
    no __send__ needed                             getattr cannot be shadowed by the class
12. getattr.__module__ / type(getattr).__name__    builtins / builtin_function_or_method
13. getattr(calc, "add")(1) -- arity is still checked TypeError
