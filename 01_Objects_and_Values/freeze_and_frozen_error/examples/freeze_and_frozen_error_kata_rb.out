   config.frozen?             true
   config[:list].frozen?      true
   config[:list][1].frozen?   true
   config[:name].frozen?      true
   config[:list][1] << 3      FrozenError: can't modify frozen Array: [2]
   config[:name] << "!"       FrozenError: can't modify frozen String: "n"
   config[:extra] = 1         FrozenError: can't modify frozen Hash: {list: [1, [2]], name: "n"}
   Ractor.shareable?(config)  true
