 1. 1 <=> 2, 2 <=> 2, 3 <=> 2                                    [-1, 0, 1]
 2. 1 <=> "a", nil <=> 1, nil <=> nil                            [nil, nil, 0]
 3. [1, 2] <=> [1, 3], [1, 2] <=> [1, 2, 0], [1, "a"] <=> [1, 2] [-1, -1, nil]
 4. Version a = v1.10, b = v1.9: a > b, a < b, a == v1.10, a >= b [true, false, true, true]
 5. a.between?(b, v2.0), a.clamp(b, b), a.clamp(v0.1..v1.0)      [true, v1.9, v1.0]
 6. [a, b, v1.2].sort, [a, b].min, [a, b].max                    [[v1.2, v1.9, v1.10], v1.9, v1.10]
 7. a < "1.0"; a == "1.0"                                        ArgumentError: comparison of Version with String failed; false
 8. Comparable.instance_methods.sort                             [:<, :<=, :==, :>, :>=, :between?, :clamp]
 9. Integer, String, Float, Symbol, Array, NilClass: Comparable? [true, true, true, true, false, false]
10. [1, 2] < [1, 3]  (Array has <=> but not Comparable)          NoMethodError: undefined method '<' for an instance of Array
11. [3, nil].sort; [3, nil].max                                  ArgumentError: comparison of Integer with nil failed; ArgumentError: comparison of Integer with nil failed
12. [3, "a"].sort                                                ArgumentError: comparison of Integer with String failed
13. [3, nil].compact.sort, [3, nil].sort_by(&:to_i)              [[3], [nil, 3]]
14. OnlySpaceship: [s2, s1].sort, .min; s1 < s2; s1 == S1        [S1, S2], S1; NoMethodError: undefined method '<' for an instance of OnlySpaceship; false
15. Float::NAN <=> 1.0; [Float::NAN, 1.0].sort                   nil; ArgumentError: comparison of Float with 1.0 failed
16. "a" <=> "B", "abc" <=> "ab", :a <=> :b                       [1, 1, -1]
17. 1 <=> 1.0, 1 == 1.0, [1, 1.0].max.class, [1.0, 1].max.class  [0, true, Integer, Float]
18. [3, 1, 2].sort { |x, y| y <=> x }, .max(2), .minmax          [[3, 2, 1], [3, 2], [1, 3]]
19. 2.clamp(3, 1)                                                ArgumentError: min argument must be less than or equal to max argument
