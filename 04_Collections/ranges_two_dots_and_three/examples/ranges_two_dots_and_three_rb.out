13. (1..100).sum, (1..10**12).sum  (a formula, not a loop)   [5050, 500000000000500000000000]
14. (1...5).last, (1...5).last(1), (1...5).max               [5, [4], 4]
15. (5..1).to_a, 5.downto(1).to_a                            [[], [5, 4, 3, 2, 1]]
16. (1..5) == (1...6), (1..5).to_a == (1...6).to_a           [false, true]
