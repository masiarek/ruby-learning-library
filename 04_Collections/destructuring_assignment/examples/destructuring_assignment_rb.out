 1. a, b = 1, 2                                              [1, 2]
 2. a, b = b, a  (swap)                                      [2, 1]
 3. a, *b = [1, 2, 3]; *c, d = [1, 2, 3]                     [[1, [2, 3]], [[1, 2], 3]]
 4. a, *b, c = 1, 2, 3, 4                                    [1, [2, 3], 4]
 5. (a, b), c = [1, 2], 3  (nested)                          [1, 2, 3]
 6. first, = [1, 2]  (trailing comma: take the first)        1
 7. a, b = [1]  (too few: nil)                               [1, nil]
 8. a, b = 1, 2, 3  (too many: dropped)                      [1, 2]
 9. a = 1, 2  (one target: an Array)                         [1, 2]
10. a, b = "xy"  (a String does not splat)                   ["xy", nil]
11. a, b = {x: 1, y: 2}  (nor does a Hash)                   [{x: 1, y: 2}, nil]
12. a, b = nil                                               [nil, nil]
13. v = (a, b = 1, 2)  (the assignment is an expression)     [1, 2]
14. pairs.map { |x, y| x + y }  (a block auto-splats)        [3, 7]
15. pairs.each_with_index.map { |(x, y), i| }                ["0:3", "1:7"]
16. {a: 1, b: 2}.map { |k, v| "#{k}#{v}" }                   ["a1", "b2"]
17. ->(x, y) {}.call([1, 2]); proc { |x, y| }.call([1, 2]); m([1, 2]) ["ArgumentError: wrong number of arguments (given 1, expected 2)", [1, 2], ArgumentError]
18. a, b = obj with to_ary; c, d = a Struct (no to_ary)      [[7, 8], [#<struct Point x=1, y=2>, nil]]
19. def two = (return 1, 2); two, then a, b = two            [[1, 2], [1, 2]]
