 1. a = [10, 20, 30, 40]; a.length               4
 2. a[0], a[-1]  (negative: from the end)        [10, 40]
 3. a[10], a[-10]  (past either end)             [nil, nil]
 4. a.fetch(10)  (the raising form)              IndexError: index 10 outside of array bounds: -4...4
 5. a.fetch(10, :none)                           :none
 6. a[1..2]  (two dots: end included)            [20, 30]
 7. a[1...3]  (three dots: end excluded)         [20, 30]
 8. a[1..]  (endless range: to the end)          [20, 30, 40]
 9. a[1, 2]  (start, length)                     [20, 30]
10. a[4..], a[5..]  (slice at / past the end)    [[], nil]
11. b[5] = 99 on a 4-element copy (pads)         [10, 20, 30, 40, nil, 99]
12. d = a.dup; d[-5] = 1  (before the start)     IndexError: index -5 too small for array; minimum: -4
13. a.first(2), a.last(2), [].first              [[10, 20], [30, 40], nil]
14. a.values_at(0, 2, 10)                        [10, 30, nil]
15. Array.new(3, []) then x[0] << 1  (shared)    [[1], [1], [1]]
16. Array.new(3) { [] } then y[0] << 1 (fresh)   [[1], [], []]
17. nested.flatten, nested.flatten(1)            [[1, 2, 3, 4], [1, 2, [3, [4]]]]
18. c = [1, 2]; c.push(3) << 4  (returns c)      [1, 2, 3, 4]
19. c.pop, c.shift, then c                       [4, 1, [2, 3]]
20. c.unshift(0)  (returns c)                    [0, 2, 3]
21. [*a, 5], [*1..3], f(*a) with def f(*args)    [[10, 20, 30, 40, 5], [1, 2, 3], [10, 20, 30, 40]]
22. a - [20], a & [20, 99], a | [99]             [[10, 30, 40], [20], [10, 20, 30, 40, 99]]
