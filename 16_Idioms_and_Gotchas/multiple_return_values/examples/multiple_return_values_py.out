 1. def pair(): return 1, 2 -> pair(), type      (1, 2), tuple
 2. x, y = pair()                                x=1 y=2
 3. divmod(7, 2)                                 (3, 1)
 4. two comprehensions (no partition)            ([2, 4], [1, 3])
 5. (min(xs), max(xs))   (no minmax)             (1, 3)
 6. first, *rest = triple()                      first=1 rest=[2, 3]
 7. _, second = pair()                           second=2
 8. operator.itemgetter("a", "c")(d)             (1, 3)
 9. namedtuple: div_mod(7, 2), .q                Pair(q=3, r=1), q=3
10. dataclass: c = Coord(1, 2); x, y = astuple(c) Coord(x=1, y=2); x=1 y=2
11. a, b = 1 / c1, c2 = [1, 2, 3]                TypeError / ValueError  (both raise)
12. def nothing(): pass -> type(nothing())       NoneType
