 1. def pair; return 1, 2; end -> pair, pair.class [1, 2], Array
 2. x, y = pair                                  x=1 y=2
 3. 7.divmod(2)                                  [3, 1]
 4. [1, 2, 3, 4].partition(&:even?)              [[2, 4], [1, 3]]
 5. [3, 1, 2].minmax                             [1, 3]
 6. first, *rest = triple                        first=1 rest=[2, 3]
 7. _, second = pair                             second=2
 8. {a: 1, b: 2, c: 3}.values_at(:a, :c)         [1, 3]
 9. Struct: div_mod(7, 2), .q                    #<struct Pair q=3, r=1>, q=3
10. Data: c = Coord.new(x: 1, y: 2); c => {x:, y:} #<data Coord x=1, y=2>; x=1 y=2
11. a, b = 1 / c1, c2 = [1, 2, 3]                a=1 b=nil / c1=1 c2=2  (no error)
12. def nothing; end -> nothing.class            NilClass
