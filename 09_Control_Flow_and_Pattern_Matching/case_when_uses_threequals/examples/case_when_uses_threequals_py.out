 1. 3: when Integer, Float                 -> 'number'
 2. 3: when 1..5                           -> 'small'  (guard: case int(x) if 1 <= x <= 5)
 3. "id 42": when /(\d+)/ sets $~          -> 'digits 42'  (guard: if (m := re.search(...)))
 4. 150: when ->(n) { n > 100 }            -> 'big'  (guard: case n if n > 100)
 5. "e": when *VOWELS                      -> 'vowel'  (case "a" | "e" | "i" | "o" | "u")
 6. 1: when 1 ... when Integer             -> 'first'  (no fall-through)
 7. case with no subject, n = -4           -> SyntaxError for a bare match:; if/elif gives 'negative'
 8. 99: no when matches                    -> None; with case _: -> 'other'
 9. 4, 7: when Even (a custom ===)         -> even / odd  (case Even(): via __instancecheck__)
10. 1.0: when 1                            -> matched  (1 == 1.0 -> True)
11. nil: when nil                          -> matched  (case None: uses `is`)
12. what when calls                        -> isinstance(3, int) -> True; 3 in range(1, 6) -> True; bool(re.search("ab", "cab")) -> True; (lambda n: n > 100)(150) -> True
